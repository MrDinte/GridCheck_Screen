# ESP-IDF settings for the Waveshare ESP32-S3-Knob-Touch-LCD-1.8 / 1.8B (round 360x360).
# Same as sdkconfig.defaults (the 7") without the RGB-panel workarounds: this
# screen has its own frame memory, filled over QSPI, so it doesn't flicker
# when flash or PSRAM are busy.

# ---- chip, flash, PSRAM (ESP32-S3R8: 8 MB octal PSRAM; 16 MB flash, DIO as in Waveshare's demo) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- web server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_MAX_SOCKETS=16

# ---- updates over Wi-Fi ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# ---- HTTPS (update check, forecast) ----
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---- Tailscale (MicroLink, components/microlink) ----
# Its Noise handshake needs ChaCha20-Poly1305 and HKDF from mbedTLS.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# Relay through Sydney when no direct path can be made (Tailscale DERP region 5).
CONFIG_ML_DERP_REGION=5
CONFIG_ML_MAX_PEERS=8
# GridCheck confirms its own updates (ota.cpp); MicroLink must not roll them back.
CONFIG_ML_OTA_ROLLBACK=n
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
CONFIG_ML_LOG_LEVEL_WARN=y
